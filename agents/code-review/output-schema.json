{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Review Report",
  "type": "object",
  "required": [
    "verdict",
    "findings",
    "domainCompliance",
    "coverageMap",
    "summary",
    "retrospective"
  ],
  "additionalProperties": true,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "APPROVE_WITH_NOTES", "REQUEST_CHANGES"],
      "description": "Review verdict"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "file",
          "category",
          "issue",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "file": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "domainCompliance": {
      "type": "object",
      "properties": {
        "filePlacement": {
          "type": "string"
        },
        "contractImports": {
          "type": "string"
        },
        "dependencyDirection": {
          "type": "string"
        },
        "domainDocsUpdated": {
          "type": "string"
        },
        "registryCurrent": {
          "type": "string"
        },
        "mapCurrent": {
          "type": "string"
        }
      }
    },
    "coverageMap": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ac": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "retrospective": {
      "type": "object",
      "required": ["workedWell", "confusing", "magicWand"],
      "additionalProperties": true,
      "properties": {
        "workedWell": {
          "type": "string",
          "minLength": 10
        },
        "confusing": {
          "type": "string",
          "minLength": 10
        },
        "magicWand": {
          "type": "string",
          "minLength": 20
        },
        "magicWandTarget": {
          "type": "string",
          "enum": ["project", "minih", "coordination"],
          "description": "Which system does the magic wand target — the project being tested, minih itself, or coordination?"
        },
        "difficulties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "description", "severity"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Self-assigned ID (e.g., MH-001)."
              },
              "category": {
                "type": "string",
                "minLength": 2,
                "description": "Friction category (e.g., build, config, data, test, debug, knowledge)."
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "description": "What happened — be specific."
              },
              "workaround": {
                "type": ["string", "null"],
                "description": "What you did to get past it, or null."
              },
              "severity": {
                "type": "string",
                "enum": ["blocking", "degrading", "annoying"],
                "description": "How badly this affected you."
              }
            }
          },
          "description": "Structured friction reports for the difficulty ledger."
        }
      }
    }
  }
}
