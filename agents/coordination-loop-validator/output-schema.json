{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordination Loop Validator Report",
  "type": "object",
  "required": [
    "summary",
    "verdict",
    "milestones",
    "stateChecks",
    "promptChecks",
    "finalValidation",
    "retrospective"
  ],
  "additionalProperties": true,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 40
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "partial", "fail"]
    },
    "milestones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "milestoneId",
          "status",
          "outsideMessage",
          "acknowledgement",
          "stateEvidence",
          "feedback",
          "outsideReadback"
        ],
        "additionalProperties": true,
        "properties": {
          "milestoneId": {
            "type": "string",
            "enum": ["area-1", "area-2", "area-3"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "missing", "partial", "fail"]
          },
          "outsideMessage": {
            "type": "object",
            "required": [
              "received",
              "messageId",
              "type",
              "subject",
              "bodySummary"
            ],
            "additionalProperties": true,
            "properties": {
              "received": { "type": "boolean" },
              "messageId": {
                "type": ["string", "null"]
              },
              "type": {
                "type": ["string", "null"]
              },
              "subject": {
                "type": ["string", "null"]
              },
              "bodySummary": {
                "type": "string"
              }
            }
          },
          "acknowledgement": {
            "type": "object",
            "required": ["acknowledged", "ackEvidence"],
            "additionalProperties": true,
            "properties": {
              "acknowledged": { "type": "boolean" },
              "ackEvidence": { "type": "string" }
            }
          },
          "stateEvidence": {
            "type": "object",
            "required": [
              "outsideStatus",
              "outsidePhase",
              "insideStatus",
              "insidePhase",
              "schemaCompatible"
            ],
            "additionalProperties": true,
            "properties": {
              "outsideStatus": {
                "type": ["string", "null"],
                "enum": ["idle", "in-progress", "paused", "done", "error", null]
              },
              "outsidePhase": {
                "type": ["string", "null"]
              },
              "insideStatus": {
                "type": ["string", "null"],
                "enum": [
                  "idle",
                  "in-progress",
                  "paused",
                  "reviewing",
                  "complete",
                  "error",
                  null
                ]
              },
              "insidePhase": {
                "type": ["string", "null"]
              },
              "schemaCompatible": { "type": "boolean" }
            }
          },
          "feedback": {
            "type": "object",
            "required": [
              "sent",
              "messageId",
              "summary",
              "usefulForOutsidePeer"
            ],
            "additionalProperties": true,
            "properties": {
              "sent": { "type": "boolean" },
              "messageId": {
                "type": ["string", "null"]
              },
              "summary": { "type": "string" },
              "usefulForOutsidePeer": { "type": "boolean" }
            }
          },
          "outsideReadback": {
            "type": "object",
            "required": ["observableCommand", "expectedVisible"],
            "additionalProperties": true,
            "properties": {
              "observableCommand": { "type": "string" },
              "expectedVisible": { "type": "boolean" }
            }
          }
        }
      }
    },
    "stateChecks": {
      "type": "object",
      "required": [
        "schemaCompatible",
        "outsideStatusesUsed",
        "insideStatusesUsed",
        "workflowVocabularyLocation",
        "observations"
      ],
      "additionalProperties": true,
      "properties": {
        "schemaCompatible": { "type": "boolean" },
        "outsideStatusesUsed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["idle", "in-progress", "paused", "done", "error"]
          }
        },
        "insideStatusesUsed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "idle",
              "in-progress",
              "paused",
              "reviewing",
              "complete",
              "error"
            ]
          }
        },
        "workflowVocabularyLocation": {
          "type": "string",
          "minLength": 20
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "promptChecks": {
      "type": "object",
      "required": [
        "insidePromptClear",
        "outsideContractClear",
        "distinguishesCoordinationFromCodeReview",
        "boundedWaitingDocumented",
        "statusVocabularyDocumented"
      ],
      "additionalProperties": true,
      "properties": {
        "insidePromptClear": { "type": "boolean" },
        "outsideContractClear": { "type": "boolean" },
        "distinguishesCoordinationFromCodeReview": { "type": "boolean" },
        "boundedWaitingDocumented": { "type": "boolean" },
        "statusVocabularyDocumented": { "type": "boolean" }
      }
    },
    "finalValidation": {
      "type": "object",
      "required": [
        "checkRun",
        "statusCommand",
        "tailObserved",
        "validateCommand",
        "retrosCommand"
      ],
      "additionalProperties": true,
      "properties": {
        "checkRun": { "type": "string" },
        "statusCommand": { "type": "string" },
        "tailObserved": { "type": "string" },
        "validateCommand": { "type": "string" },
        "retrosCommand": { "type": "string" }
      }
    },
    "retrospective": {
      "type": "object",
      "required": [
        "workedWell",
        "confusing",
        "magicWand",
        "magicWandTarget",
        "coordination"
      ],
      "additionalProperties": true,
      "properties": {
        "workedWell": {
          "type": "string",
          "minLength": 10
        },
        "confusing": {
          "type": "string",
          "minLength": 10
        },
        "magicWand": {
          "type": "string",
          "minLength": 20
        },
        "magicWandTarget": {
          "const": "coordination"
        },
        "coordination": {
          "type": "object",
          "required": [
            "peerUpdatesSent",
            "unresolvedPeerRequests",
            "statePublished",
            "notes"
          ],
          "additionalProperties": true,
          "properties": {
            "peerUpdatesSent": {
              "type": "integer",
              "minimum": 0
            },
            "unresolvedPeerRequests": {
              "type": "integer",
              "minimum": 0
            },
            "statePublished": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "difficulties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "description", "severity"],
            "additionalProperties": true,
            "properties": {
              "category": { "type": "string" },
              "description": { "type": "string" },
              "workaround": {
                "type": ["string", "null"]
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              }
            }
          }
        }
      }
    }
  }
}
