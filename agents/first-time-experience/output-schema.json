{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "First-Time Experience Report",
  "type": "object",
  "required": [
    "steps",
    "overallScore",
    "blockers",
    "confusionPoints",
    "suggestions",
    "summary",
    "retrospective"
  ],
  "additionalProperties": true,
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["step", "description", "result", "notes"],
        "properties": {
          "step": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "partial", "skipped"]
          },
          "notes": {
            "type": "string"
          },
          "commandsRun": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "errorMessages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "overallScore": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "1-10 rating of the first-time experience"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things that completely stopped progress"
    },
    "confusionPoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things that were unclear or required trial-and-error"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Concrete improvements for the first-time experience"
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "retrospective": {
      "type": "object",
      "required": ["workedWell", "confusing", "magicWand"],
      "additionalProperties": true,
      "properties": {
        "workedWell": {
          "type": "string",
          "minLength": 10
        },
        "confusing": {
          "type": "string",
          "minLength": 10
        },
        "magicWand": {
          "type": "string",
          "minLength": 20
        },
        "magicWandTarget": {
          "type": "string",
          "enum": ["project", "minih"],
          "description": "Which system does the magic wand target — the project being tested or minih itself?"
        },
        "difficulties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "description", "severity"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 2,
                "description": "Friction category (e.g., build, config, data, test, debug, knowledge)."
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "description": "What happened — be specific."
              },
              "workaround": {
                "type": ["string", "null"],
                "description": "What you did to get past it, or null."
              },
              "severity": {
                "type": "string",
                "enum": ["blocking", "degrading", "annoying"],
                "description": "How badly this affected you."
              }
            }
          },
          "description": "Structured friction reports for the difficulty ledger."
        }
      }
    }
  }
}
