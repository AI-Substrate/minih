{
  "type": "object",
  "required": [
    "mcpAvailable",
    "toolsFound",
    "echoTestPassed",
    "summary",
    "retrospective"
  ],
  "additionalProperties": true,
  "properties": {
    "mcpAvailable": {
      "type": "boolean",
      "description": "Whether MCP config was found and servers loaded"
    },
    "toolsFound": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MCP tool names discovered in the session"
    },
    "echoTestPassed": {
      "type": "boolean",
      "description": "Whether echo tool returned the expected message"
    },
    "addTestPassed": {
      "type": "boolean",
      "description": "Whether add tool returned the expected sum"
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "retrospective": {
      "type": "object",
      "required": ["workedWell", "confusing", "magicWand"],
      "additionalProperties": true,
      "properties": {
        "workedWell": {
          "type": "string",
          "minLength": 10
        },
        "confusing": {
          "type": "string",
          "minLength": 10
        },
        "magicWand": {
          "type": "string",
          "minLength": 20
        },
        "magicWandTarget": {
          "type": "string",
          "enum": ["project", "minih"],
          "description": "Which system does the magic wand target — the project being tested or minih itself?"
        },
        "difficulties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "description", "severity"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 2,
                "description": "Friction category (e.g., build, config, data, test, debug, knowledge)."
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "description": "What happened — be specific."
              },
              "workaround": {
                "type": ["string", "null"],
                "description": "What you did to get past it, or null."
              },
              "severity": {
                "type": "string",
                "enum": ["blocking", "degrading", "annoying"],
                "description": "How badly this affected you."
              }
            }
          },
          "description": "Structured friction reports for the difficulty ledger."
        }
      }
    }
  }
}
