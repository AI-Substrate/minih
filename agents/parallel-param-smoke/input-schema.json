{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parallel Parameter Smoke Input",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "description": "Folder id under scratch/agent-runs/<id>. Accepts -p id=1 or -p id='\"1\"'.",
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 999 },
        { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" }
      ]
    },
    "message": {
      "type": "string",
      "description": "Optional message to copy into marker.json"
    }
  },
  "additionalProperties": false
}
