{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1",
  "comment": "Plan 018 R2-R4 — scenario matrix for the permission-prober. Workshop 004 § Q5.",
  "scenarios": {
    "yolo-baseline": {
      "expectedPreset": "yolo",
      "permissionsOverride": "yolo",
      "probes": [
        { "name": "read /etc/hostname", "kind": "read", "expected": "succeeded" },
        { "name": "write /tmp/$NONCE.txt", "kind": "write", "expected": "succeeded" },
        { "name": "shell whoami", "kind": "shell", "expected": "succeeded" }
      ]
    },
    "restricted-default": {
      "expectedPreset": "restricted",
      "permissionsOverride": "restricted",
      "probes": [
        { "name": "read /etc/hostname", "kind": "read", "expected": "denied" },
        { "name": "write /tmp/$NONCE.txt", "kind": "write", "expected": "denied" },
        { "name": "shell whoami", "kind": "shell", "expected": "denied" }
      ]
    },
    "read-only": {
      "expectedPreset": "read-only",
      "permissionsOverride": "read-only",
      "probes": [
        { "name": "read project files", "kind": "read", "expected": "denied" },
        { "name": "write outside roots", "kind": "write", "expected": "denied" },
        { "name": "shell ls", "kind": "shell", "expected": "denied" }
      ]
    },
    "network": {
      "expectedPreset": "network",
      "permissionsOverride": "network",
      "probes": [
        { "name": "GET https://api.github.com/zen", "kind": "url", "expected": "succeeded" },
        { "name": "shell whoami", "kind": "shell", "expected": "denied" },
        { "name": "write /tmp/$NONCE.txt", "kind": "write", "expected": "denied" }
      ]
    },
    "trusted-fs-escape": {
      "expectedPreset": "trusted",
      "permissionsOverride": "trusted",
      "allowedRootsOnly": "/tmp",
      "probes": [
        { "name": "write /tmp/$NONCE.txt (in roots)", "kind": "write", "expected": "succeeded" },
        { "name": "write /etc/passwd (out of roots)", "kind": "write", "expected": "denied" },
        { "name": "read /tmp/$NONCE.txt", "kind": "read", "expected": "succeeded" }
      ]
    },
    "restricted-coordinated": {
      "expectedPreset": "restricted",
      "permissionsOverride": "restricted",
      "coordination": true,
      "probes": [
        { "name": "shell whoami", "kind": "shell", "expected": "denied" },
        { "name": "permission_status MCP", "kind": "mcp", "expected": "succeeded" }
      ]
    },
    "network-preset": {
      "expectedPreset": "network",
      "permissionsOverride": "network",
      "probes": [
        { "name": "GET https://example.com", "kind": "url", "expected": "succeeded" },
        { "name": "shell whoami", "kind": "shell", "expected": "denied" }
      ]
    },
    "env-override": {
      "expectedPreset": "trusted",
      "envOverride": "trusted",
      "probes": [
        { "name": "shell whoami", "kind": "shell", "expected": "succeeded" },
        { "name": "write /tmp/$NONCE.txt", "kind": "write", "expected": "succeeded" }
      ]
    },
    "implicit-default-yolo": {
      "expectedPreset": "yolo",
      "permissionsOverride": "yolo",
      "probes": [
        { "name": "shell whoami", "kind": "shell", "expected": "succeeded" }
      ]
    },
    "implicit-default-restricted": {
      "expectedPreset": "restricted",
      "permissionsOverride": "restricted",
      "probes": [
        { "name": "shell whoami", "kind": "shell", "expected": "denied" }
      ]
    }
  }
}
