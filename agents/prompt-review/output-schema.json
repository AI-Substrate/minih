{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Review Report",
  "type": "object",
  "required": ["summary", "agentFound", "verdict", "retrospective"],
  "additionalProperties": true,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 20,
      "description": "Single paragraph summarizing the review findings."
    },
    "agentFound": {
      "type": "boolean",
      "description": "Whether the target agent was found in the agents directory."
    },
    "agentSlug": {
      "type": "string",
      "description": "The slug of the reviewed agent."
    },
    "aspects": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "promptClarity": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "explanation": {
              "type": "string"
            }
          }
        },
        "promptCompleteness": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "explanation": {
              "type": "string"
            }
          }
        },
        "frontmatter": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "explanation": {
              "type": "string"
            }
          }
        },
        "schemaQuality": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "explanation": {
              "type": "string"
            }
          }
        },
        "instructionsQuality": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "explanation": {
              "type": "string"
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "Specific suggestions for improving the agent."
    },
    "verdict": {
      "type": "string",
      "enum": ["excellent", "good", "needs-work", "poor"],
      "description": "Overall quality verdict."
    },
    "retrospective": {
      "type": "object",
      "required": ["workedWell", "confusing", "magicWand"],
      "additionalProperties": true,
      "properties": {
        "workedWell": {
          "type": "string",
          "minLength": 10
        },
        "confusing": {
          "type": "string",
          "minLength": 10
        },
        "magicWand": {
          "type": "string",
          "minLength": 20
        },
        "improvementSuggestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "magicWandTarget": {
          "type": "string",
          "enum": ["project", "minih", "coordination"],
          "description": "Which system does the magic wand target — the project being tested, minih itself, or coordination?"
        },
        "difficulties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "description", "severity"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Self-assigned ID (e.g., MH-001)."
              },
              "category": {
                "type": "string",
                "minLength": 2,
                "description": "Friction category (e.g., build, config, data, test, debug, knowledge)."
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "description": "What happened — be specific."
              },
              "workaround": {
                "type": ["string", "null"],
                "description": "What you did to get past it, or null."
              },
              "severity": {
                "type": "string",
                "enum": ["blocking", "degrading", "annoying"],
                "description": "How badly this affected you."
              }
            }
          },
          "description": "Structured friction reports for the difficulty ledger."
        }
      }
    }
  }
}
