{
  "type": "object",
  "required": [
    "skillName",
    "invocationAttempted",
    "skillAppearedCallable",
    "skillLoadedEventObserved",
    "skillInvokedEventObserved",
    "evidence",
    "summary",
    "retrospective"
  ],
  "additionalProperties": true,
  "properties": {
    "skillName": {
      "type": "string",
      "const": "grill-me"
    },
    "invocationAttempted": {
      "type": "boolean"
    },
    "skillAppearedCallable": {
      "type": "boolean",
      "description": "True only when the runtime appears to have routed the request to the installed skill, not merely when the agent imitated the skill format."
    },
    "skillLoadedEventObserved": {
      "type": "boolean",
      "description": "True only when minih surfaced a session.skills_loaded / skills_loaded event for grill-me."
    },
    "skillInvokedEventObserved": {
      "type": "boolean",
      "description": "True only when minih surfaced a skill.invoked / skill_invoked event for grill-me."
    },
    "evidence": {
      "type": "string",
      "minLength": 20
    },
    "observedBehavior": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "retrospective": {
      "type": "object",
      "required": ["workedWell", "confusing", "magicWand"],
      "additionalProperties": true,
      "properties": {
        "workedWell": {
          "type": "string",
          "minLength": 10
        },
        "confusing": {
          "type": "string",
          "minLength": 10
        },
        "magicWand": {
          "type": "string",
          "minLength": 20
        },
        "magicWandTarget": {
          "type": "string",
          "enum": ["project", "minih", "coordination"]
        }
      }
    }
  }
}
