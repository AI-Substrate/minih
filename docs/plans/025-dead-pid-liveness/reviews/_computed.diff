+
+    const result = cli(['--agents-dir', agentsDir, 'reconcile', 'alpha']);
+
+    expect(result.exitCode).not.toBe(0);
+    const envelope = JSON.parse(result.stdout);
+    expect(envelope.status).toBe('error');
+    expect(envelope.error.code).toBe('E190');
