+    expect(envelope.data.healed[0]).toMatchObject({
+      slug: 'alpha',
+      runId,
+      pid: DEAD_PID,
+      previousStatus: 'active',
+    });
+    expect(envelope.data.filters).toEqual({
+      slug: 'alpha',
+      runId: null,
+      all: false,
+    });
+
+    const manifest = JSON.parse(
+      fs.readFileSync(path.join(runDir, 'run.json'), 'utf-8'),
