{
  "name": "minih",
  "version": "0.2.4",
  "description": "Standalone declarative agent runner with self-improving feedback",
  "type": "module",
  "bin": {
    "minih": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapter": {
      "import": "./dist/adapter/index.js",
      "types": "./dist/adapter/index.d.ts"
    },
    "./runner": {
      "import": "./dist/runner/index.js",
      "types": "./dist/runner/index.d.ts"
    },
    "./schemas/retrospective.json": "./dist/schemas/retrospective.json",
    "./schemas/system-output.json": "./dist/schemas/system-output.json"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-schemas.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "gpt-tokenizer": "3.4.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "tar": "^7.5.22"
  },
  "peerDependencies": {
    "@github/copilot-sdk": ">=0.1.32"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@github/copilot-sdk": "1.0.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
