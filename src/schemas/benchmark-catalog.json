{
  "$id": "https://minih.dev/schemas/benchmark-catalog.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minih Benchmark Catalog",
  "description": "Catalogue of benchmark scenarios and proof requirements; it does not contain benchmark execution results.",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "generatedAt",
    "benchmarks",
    "provenance",
    "redaction"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/benchmark" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "redaction": { "$ref": "#/$defs/redaction" }
  },
  "$defs": {
    "benchmark": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "scenario",
        "taskKind",
        "defaultProofLevel",
        "requiredArtifactKinds",
        "metricIds",
        "successCriteria",
        "sourceRefs",
        "redaction"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "taskKind": {
          "type": "string",
          "enum": ["benchmark", "change", "setup"]
        },
        "defaultProofLevel": {
          "type": "string",
          "enum": ["L5", "L6"]
        },
        "requiredArtifactKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["command", "rerun", "runtime-observation", "test"]
          },
          "uniqueItems": true
        },
        "metricIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "redaction": { "$ref": "#/$defs/redaction" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "generatedAt", "evidenceIds"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "const": "runner" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "redaction": {
      "type": "object",
      "required": ["posture", "containsPersonalData", "exportSafe", "notes"],
      "additionalProperties": false,
      "properties": {
        "posture": {
          "type": "string",
          "enum": ["local-only", "redacted-export"]
        },
        "containsPersonalData": { "type": "boolean" },
        "exportSafe": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
