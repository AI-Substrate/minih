{
  "$id": "https://minih.dev/schemas/measurement-event.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minih Measurement Event",
  "description": "Runner-owned factual event used as evidence for later measurement summaries.",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "runId",
    "occurredAt",
    "authority",
    "kind",
    "evidenceId",
    "summary",
    "data",
    "missingData",
    "provenance",
    "redaction"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "eventId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "authority": { "type": "string", "const": "runner-fact" },
    "kind": {
      "type": "string",
      "enum": [
        "artifact",
        "benchmark",
        "coordination",
        "difficulty",
        "retro",
        "run-complete",
        "run-start",
        "validation"
      ]
    },
    "evidenceId": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "data": { "type": "object", "additionalProperties": true },
    "missingData": {
      "type": "array",
      "items": { "$ref": "#/$defs/missingData" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "redaction": { "$ref": "#/$defs/redaction" }
  },
  "$defs": {
    "missingData": {
      "type": "object",
      "required": ["field", "reason", "description"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "reason": {
          "type": "string",
          "enum": [
            "not-applicable",
            "not-collected",
            "not-configured",
            "redacted"
          ]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "generatedAt", "evidenceIds"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "const": "runner" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "redaction": {
      "type": "object",
      "required": ["posture", "containsPersonalData", "exportSafe", "notes"],
      "additionalProperties": false,
      "properties": {
        "posture": {
          "type": "string",
          "enum": ["local-only", "redacted-export"]
        },
        "containsPersonalData": { "type": "boolean" },
        "exportSafe": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
